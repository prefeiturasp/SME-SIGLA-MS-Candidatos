# Django settings
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=db_sigla
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Static files
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# Media files
MEDIA_URL=/media/
MEDIA_ROOT=media

# Logging
LOG_LEVEL=INFO

# Email settings (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Elastic APM (desabilitado por padrão; ENABLED=1 para ligar)
AMBIENTE_APLICACAO=local
ELASTIC_APM_SERVICE_NAME=SME-SIGLA-MS-Candidatos
ELASTIC_APM_SECRET_TOKEN=
ELASTIC_APM_SERVER_URL=url-do-apm-server-aqui
ELASTIC_APM_ENVIRONMENT=local
ELASTIC_APM_ENABLED=0
ELASTIC_APM_CAPTURE_HEADERS=1
ELASTIC_APM_TRANSACTION_SAMPLE_RATE=0.3
ELASTIC_APM_METRICS_INTERVAL=10s
ELASTIC_APM_FLUSH_INTERVAL=10s
ELASTIC_APM_MAX_BATCH_EVENT_COUNT=1000
ELASTIC_APM_MAX_QUEUE_EVENT_COUNT=1000
ELASTIC_APM_TRANSACTION_MAX_SPANS=500
ELASTIC_APM_LOG_LEVEL=INFO
